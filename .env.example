# AgriDistri — Configuration de l'environnement
# Copiez ce fichier en .env et adaptez les valeurs

# SERVEUR
PORT=3000
FLASK_ENV=development
# FLASK_ENV=production  # Décommentez en production

# SÉCURITÉ — CLÉS SECRÈTES
SECRET_KEY=changez-cette-cle-secrete-minimum-32-caracteres
JWT_SECRET_KEY=changez-cette-cle-jwt-minimum-32-caracteres

# COOKIES JWT
# Durée de validité du token d'accès (en heures)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
# Durée de validité du refresh token (en jours)
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS — ORIGINES AUTORISÉES
# En développement : http://localhost:3000
# En production : votre domaine réel (ex: https://agridistri.com)
ALLOWED_ORIGINS=http://localhost:3000

# RATE LIMITING
# Nombre de tentatives de connexion max par fenêtre de 15 min
LOGIN_RATE_LIMIT=5 per 15 minutes
# Limite générale des APIs
API_RATE_LIMIT=60 per minute
